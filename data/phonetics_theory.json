  "special_rules": [
    {
      "title": "1. Quy tắc phát âm đuôi -ED (/t/, /d/, /ɪd/)",
      "rules": [
        "Phát âm là /ɪd/: Khi động từ kết thúc bằng âm /t/ hoặc /d/ (vd: wanted, needed, decided).",
        "Phát âm là /t/: Khi động từ kết thúc bằng các âm vô thanh: /p/, /k/, /f/, /s/, /ʃ/, /tʃ/ (vd: stopped, cooked, laughed, washed, watched).",
        "Phát âm là /d/: Khi động từ kết thúc bằng các âm hữu thanh còn lại và các nguyên âm (vd: played, cleaned, loved, opened)."
      ]
    },
    {
      "title": "2. Quy tắc phát âm đuôi -S / -ES (/s/, /z/, /ɪz/)",
      "rules": [
        "Phát âm là /ɪz/: Khi từ kết thúc bằng các âm xuýt: /s/, /z/, /ʃ/, /ʒ/, /tʃ/, /dʒ/ (vd: watches, boxes, kisses, changes).",
        "Phát âm là /s/: Khi từ kết thúc bằng các âm vô thanh: /p/, /t/, /k/, /f/, /θ/ (vd: cups, cats, books, laughs).",
        "Phát âm là /z/: Khi từ kết thúc bằng các âm hữu thanh còn lại và các nguyên âm (vd: dogs, bags, trees, days)."
      ]
    }
  ]
